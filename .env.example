# Copy to .env at repository root if defaults need changing.
SERVER_PORT=3001
CLIENT_PORT=5173
# Opt in to trusted LAN testing: this host computer's private IPv4 (not 0.0.0.0).
# Empty preserves loopback-only access. Node always remains on loopback.
LAN_HOST=
ALLOWED_ORIGIN=http://127.0.0.1:5173,http://localhost:5173
# Empty uses Vite's same-origin Socket.IO proxy (also in npm run preview).
VITE_SERVER_URL=
